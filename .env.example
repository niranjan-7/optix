# Copy to .env and fill in. NEVER commit .env.

# --- Mode ---------------------------------------------------------------
# Paper trading is the default. Real orders need BOTH this = true AND a
# typed confirmation at startup. Leave false until the go-live checklist
# in the README is complete.
LIVE_TRADING=false

# --- Where prices come from ---------------------------------------------
# live      = real Angel One prices (needs the Angel One settings below). Orders are still PAPER.
# simulated = made-up prices, so you can try the system before you have an Angel One account.
TRADER_FEED=live

# --- Angel One SmartAPI -------------------------------------------------
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
# Base32 secret shown when you enable TOTP (not the 6-digit code)
ANGEL_TOTP_SECRET=

# --- Telegram alerts (optional; the system runs fine without them) ------
# Steps are in docs/telegram.md. Put these ONLY here, never in chat or git.
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (a number). Find it with:  python -m trader.alerts whoami
# Commands (/kill, /reset ...) are accepted ONLY from this private chat.
TELEGRAM_CHAT_ID=

# --- Webhook (module 8) -------------------------------------------------
# Required to run the webhook, 16+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Optional extra protection: if set, requests must also carry an HMAC-SHA256
# signature of the body (header X-Signature). TradingView cannot send headers,
# so leave this empty if TradingView is your only sender.
WEBHOOK_HMAC_SECRET=

# --- Dead man's switch (optional, recommended) --------------------------
# A crashed program cannot send you an alert. Create a free check at healthchecks.io (or similar),
# set it to expect a ping every 1-2 minutes, and paste its ping URL here. If the pings stop, THEY message you.
HEARTBEAT_URL=
